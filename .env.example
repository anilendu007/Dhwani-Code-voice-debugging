# Copy to .env and add your Gemini API key. Never commit the real .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TIMEOUT_S=90

# Optional Judge0 settings for the backend API only. The browser runner needs neither.
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# Protect public demos. Limits are in-memory and reset when the server restarts.
RATE_LIMIT_PER_HOUR=8
DAILY_CAP=200
OWNER_KEY=

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_MB=8
LOG_LEVEL=INFO
