# Copy to .env and fill in. Never commit the real .env.

# --- Gnani (Prisma STT + Timbre TTS) ---------------------------------------
# Create a key at https://app.gnani.ai/voice  (dashboard -> API keys)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Some accounts allow only one active request at a time. Raise this if yours allows more.
GNANI_MAX_CONCURRENCY=1

# Speech-to-text: prisma-v2.5 (default) or prisma-v3.0.
# v2.5 boosts words through bias_list (single words). v3.0 takes real keyterms/topic.
STT_MODEL=prisma-v2.5
STT_BIAS_SCORE=1.0

# Text-to-speech: timbre-v2.5 (default) or timbre-v3.0.
TTS_MODEL=timbre-v2.5
# Leave empty to use a sensible voice per spoken language
# (v2.5: Poorvi / Nalini / Noopur, v3.0: Shivani). Set it to force one voice for every language.
TTS_VOICE=
TTS_SPEED=1.0
# One of 8000, 16000, 22050, 24000, 44100, 48000
TTS_SAMPLE_RATE=24000

# --- Evon v3.3 (reasoning) --------------------------------------------------
# Evon v3.3 is open weights and is not on the Gnani API platform. Serve it yourself with
# vLLM or SGLang (see README) and point this at the OpenAI-compatible base URL, including /v1.
# Leave EVON_BASE_URL empty to use the built-in demo analyzer (3 known bug patterns only).
EVON_BASE_URL=
EVON_API_KEY=
# The name your server registered: "model" with the vLLM command in the model card,
# "gnani-evon-v3.3" with the SGLang command.
EVON_MODEL=gnani-evon-v3.3
# Thinking traces add seconds of latency. Keep off for spoken answers.
EVON_ENABLE_THINKING=false
EVON_TIMEOUT_S=60

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_MB=8
LOG_LEVEL=INFO
